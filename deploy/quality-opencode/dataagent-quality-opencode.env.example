# Copy to /etc/dataagent-quality-opencode.env, chmod 600, then replace the value.
# The account is used exclusively by the DataAgent container over the Docker bridge.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-with-a-long-random-secret
OPENCODE_CONFIG=/opt/dataagent-quality-skills/runtime/opencode-provider.json
OPENCODE_CONFIG_DIR=/opt/dataagent-quality-skills/runtime/.opencode
# An OpenAI-compatible endpoint; keep the trailing /v1 when required by the provider.
DATA_AGENT_QUALITY_PROVIDER_BASE_URL=https://provider.example.com/v1
DATA_AGENT_QUALITY_PROVIDER_API_KEY=replace-with-platform-key
DATA_AGENT_QUALITY_PROVIDER_MODEL_ID=replace-with-model-id
